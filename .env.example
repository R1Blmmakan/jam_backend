# BitChord Listen Together Server Configuration

# HTTP & WebSocket listener port
PORT=8080

# Trust Cloudflare Tunnel headers (CF-Connecting-IP, X-Forwarded-For)
TRUST_PROXY=true
JAM_TRUST_PROXY=true

# Low-latency TCP & WebSocket buffer tuning
JAM_TCP_NODELAY=true
JAM_WS_READ_BUFFER_SIZE=2048
JAM_WS_WRITE_BUFFER_SIZE=2048

# Allowed CORS origins for web clients (leave blank for native mobile app only)
# JAM_ALLOWED_ORIGINS=https://app.yourdomain.com

# Party capacity limits
JAM_MAX_PARTIES=500
JAM_MAX_MEMBERS=5
JAM_MAX_CONCURRENT_SOCKETS=1000
JAM_MAX_SOCKETS_PER_IP=25

# Synchronization timing (milliseconds)
JAM_PLAY_LEAD_MS=350
JAM_STATE_HEARTBEAT_MS=5000
JAM_DISCONNECT_GRACE_MS=45000
JAM_EMPTY_PARTY_TTL_MS=60000
JAM_PARTY_MAX_AGE_MS=86400000
